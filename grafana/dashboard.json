{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Quick Facts",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "process_uptime_seconds{application=\"$application\", instance=\"$instance\"}", "refId": "A" }],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500000000 }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"})", "refId": "A" }],
      "title": "Heap Used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"nonheap\"})", "refId": "A" }],
      "title": "Non-Heap Used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "jvm_threads_live_threads{application=\"$application\", instance=\"$instance\"}", "refId": "A" }],
      "title": "Live Threads",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "JVM Memory",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"}", "legendFormat": "{{id}} used", "refId": "A" },
        { "expr": "jvm_memory_committed_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"}", "legendFormat": "{{id}} committed", "refId": "B" }
      ],
      "title": "JVM Heap Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"nonheap\"}", "legendFormat": "{{id}} used", "refId": "A" },
        { "expr": "jvm_memory_committed_bytes{application=\"$application\", instance=\"$instance\", area=\"nonheap\"}", "legendFormat": "{{id}} committed", "refId": "B" }
      ],
      "title": "JVM Non-Heap Memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "title": "JVM Misc",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "process_cpu_usage{application=\"$application\", instance=\"$instance\"}", "legendFormat": "Process CPU", "refId": "A" },
        { "expr": "system_cpu_usage{application=\"$application\", instance=\"$instance\"}", "legendFormat": "System CPU", "refId": "B" }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_threads_live_threads{application=\"$application\", instance=\"$instance\"}", "legendFormat": "Live", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads{application=\"$application\", instance=\"$instance\"}", "legendFormat": "Daemon", "refId": "B" },
        { "expr": "jvm_threads_peak_threads{application=\"$application\", instance=\"$instance\"}", "legendFormat": "Peak", "refId": "C" }
      ],
      "title": "Threads",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "title": "GC",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "{{gc}} {{action}}", "refId": "A" }
      ],
      "title": "GC Pause Duration (rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_count{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "{{gc}} {{action}}", "refId": "A" }
      ],
      "title": "GC Pause Count (rate)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "title": "gRPC Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(grpc_requests_total{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "{{method}} requests/s", "refId": "A" },
        { "expr": "rate(grpc_client_requests_total{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "{{method}} client requests/s", "refId": "B" }
      ],
      "title": "gRPC Requests Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "grpc_request_duration_seconds{application=\"$application\", instance=\"$instance\", quantile=\"0.5\"}", "legendFormat": "p50 (median)", "refId": "A" },
        { "expr": "grpc_request_duration_seconds{application=\"$application\", instance=\"$instance\", quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "grpc_request_duration_seconds{application=\"$application\", instance=\"$instance\", quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" },
        { "expr": "grpc_client_request_duration_seconds{application=\"$application\", instance=\"$instance\", quantile=\"0.5\"}", "legendFormat": "client p50", "refId": "D" },
        { "expr": "grpc_client_request_duration_seconds{application=\"$application\", instance=\"$instance\", quantile=\"0.95\"}", "legendFormat": "client p95", "refId": "E" }
      ],
      "title": "gRPC Request Duration (percentiles)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(grpc_errors_total{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "server errors/s", "refId": "A" },
        { "expr": "rate(grpc_client_errors_total{application=\"$application\", instance=\"$instance\"}[1m])", "legendFormat": "client errors/s", "refId": "B" }
      ],
      "title": "gRPC Errors Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(logback_events_total{application=\"$application\", instance=\"$instance\", level=\"error\"}[1m])", "legendFormat": "errors/s", "refId": "A" },
        { "expr": "rate(logback_events_total{application=\"$application\", instance=\"$instance\", level=\"warn\"}[1m])", "legendFormat": "warns/s", "refId": "B" }
      ],
      "title": "Log Events Rate",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["jvm", "micrometer", "spring-boot", "grpc"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(application)",
        "name": "application",
        "label": "Application",
        "query": { "qryType": 1, "query": "label_values(application)" },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(jvm_memory_used_bytes{application=\"$application\"}, instance)",
        "name": "instance",
        "label": "Instance",
        "query": { "qryType": 1, "query": "label_values(jvm_memory_used_bytes{application=\"$application\"}, instance)" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "gRPC Currency Services - JVM & Metrics",
  "uid": "grpc-currency-services",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ]
}
